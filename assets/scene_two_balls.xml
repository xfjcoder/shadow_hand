<mujoco model="right_shadow_hand two balls">
  <!-- Stage 3 / baoding: the vendored hand plus two 45mm / 80g balls (same ball as Stage 2's
       scene_one_ball.xml), different colours so each ball's own path can be told apart. -->
  <include file="right_hand.xml"/>

  <statistic extent="0.3"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="8192"/>
    <global azimuth="220" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="ball1" rgba="0.85 0.65 0.2 1" specular="0.6" shininess="0.6"/>
    <material name="ball2" rgba="0.75 0.2 0.2 1" specular="0.6" shininess="0.6"/>
  </asset>

  <worldbody>
    <light pos="0 0 1"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 -0.1" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="ball1" pos="0.27 0 0.05">
      <freejoint/>
      <geom name="ball1" type="sphere" size="0.0225" mass="0.08" material="ball1" condim="6" priority="1"
        friction="0.8 0.01 0.001"/>
    </body>
    <body name="ball2" pos="0.32 0 0.05">
      <freejoint/>
      <geom name="ball2" type="sphere" size="0.0225" mass="0.08" material="ball2" condim="6" priority="1"
        friction="0.8 0.01 0.001"/>
    </body>
  </worldbody>
</mujoco>
